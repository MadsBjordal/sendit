# Copy to .env and adjust. Never commit .env.

# --- Branding (the product name is not final; change it here) ---
BRAND_NAME=Project Freight
BRAND_SUPPORT_EMAIL=support@example.com

# --- Database ---
DATABASE_URL=postgres://freight:freight@localhost:55432/freight
TEST_DATABASE_URL=postgres://freight:freight@localhost:55432/freight_test

# --- API server ---
API_PORT=4000
# The address people open in the browser (used for links in emails and the cookie/Origin check)
PUBLIC_URL=http://localhost:3000
# Long random string. Signs nothing secret today but is required in production.
SESSION_SECRET=change-me-in-production

# --- Adapters: which outside service is used (dev = built-in simulators, clearly labelled) ---
# payments: test (simulated, no real money) | stripe (not implemented yet)
PAYMENT_PROVIDER=test
# Shared secret the payment provider signs its webhooks with
PAYMENT_WEBHOOK_SECRET=dev-webhook-secret
# routing: estimate (straight line x road factor, NOT truck routing) | (commercial provider: not implemented yet)
ROUTING_PROVIDER=estimate
# email: log (written to the outbox table and the log only) | smtp (sends through SMTP_URL)
EMAIL_PROVIDER=log
# e.g. smtps://user:password@smtp.example.com:465 (an EU-hosted transactional email service)
SMTP_URL=
EMAIL_FROM=Project Freight <no-reply@example.com>

# --- Files (photos, signatures, proofs of delivery). Private; never served without an access check.
FILE_STORAGE_DIR=./data/files
# Hours a customer has to confirm or dispute a delivery before it is accepted automatically
DELIVERY_ACCEPT_HOURS=48
# Days driver positions are kept
TRACKING_RETENTION_DAYS=90

# Origins allowed to call the API with a bearer token (comma separated), e.g. the driver app's web
# build in development: http://localhost:8081. Leave empty in production (native apps need none).
CORS_ORIGINS=

# --- The platform's legal entity, printed on invoices. Until all three are set, invoices say DRAFT.
LEGAL_ENTITY_NAME=
LEGAL_ENTITY_ADDRESS=
LEGAL_ENTITY_VAT=
