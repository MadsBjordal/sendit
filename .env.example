# Copy to .env and adjust. Never commit .env.

# --- Branding (the product name is not final; change it here) ---
BRAND_NAME=Project Freight
BRAND_SUPPORT_EMAIL=support@example.com

# --- Database ---
DATABASE_URL=postgres://freight:freight@localhost:5432/freight
TEST_DATABASE_URL=postgres://freight:freight@localhost:5432/freight_test

# --- API server ---
API_PORT=4000
# The address people open in the browser (used for links in emails and the cookie/Origin check)
PUBLIC_URL=http://localhost:3000
# Long random string. Signs nothing secret today but is required in production.
SESSION_SECRET=change-me-in-production

# --- Adapters: which outside service is used (dev = built-in simulators, clearly labelled) ---
# payments: test (simulated, no real money) | stripe (not implemented yet)
PAYMENT_PROVIDER=test
# Shared secret the payment provider signs its webhooks with
PAYMENT_WEBHOOK_SECRET=dev-webhook-secret
# routing: estimate (straight line x road factor, NOT truck routing) | (commercial provider: not implemented yet)
ROUTING_PROVIDER=estimate
# email: log (written to the outbox table and the log) | (real provider: not implemented yet)
EMAIL_PROVIDER=log
